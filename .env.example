# FTP / FTPS publishing
# Copy this file to .env and fill in your credentials. Never commit .env.
# Values here override blog.config.json.

BLOG_FTP_HOST=
BLOG_FTP_PORT=21
BLOG_FTP_USER=
BLOG_FTP_PASSWORD=

# false  = plain FTP
# true   = explicit FTPS (recommended)
# implicit = implicit FTPS (legacy, usually port 990)
BLOG_FTP_SECURE=false

# Absolute path on the server where the site should live.
BLOG_FTP_REMOTE_DIR=/public_html

# Optional
# BLOG_SITE_URL=https://example.com
# BLOG_BASE_PATH=/
# BLOG_FTP_TIMEOUT=30000
# BLOG_FTP_VERBOSE=false
